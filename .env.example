# Copy to .env (local dev) or paste into Vercel → Settings → Environment Variables.

# ---- Database ----
# Local dev (default): SQLite file, no setup needed.
DATABASE_URL="file:./db/custom.db"

# Production (Vercel): a real Postgres — Supabase / Neon / Vercel Postgres.
# Use the pooled connection (port 6543 on Supabase) for DATABASE_URL.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Auth ----
# Signs the admin session cookie. Set a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET=""

# ---- Streaming tuning (optional) ----
# TV_STREAM_WIDTH=1280
# TV_STREAM_HEIGHT=720
# TV_STREAM_FPS=30
# TV_STREAM_VIDEO_BITRATE=4000k
# TV_STREAM_AUDIO_BITRATE=128k
# TV_UPLOAD_DIR=/tmp/tv-uploads
